{
  "name": "@xkintaro/aether-theme",
  "version": "0.1.0",
  "description": "Shared warm light/dark theme and typography for Tailwind CSS v4 and shadcn/ui.",
  "type": "module",
  "license": "MIT",
  "style": "./styles/index.css",
  "exports": {
    ".": "./styles/index.css",
    "./tokens.css": "./styles/tokens.css",
    "./fonts.css": "./styles/fonts.css",
    "./tailwind.css": "./styles/tailwind.css"
  },
  "files": [
    "styles",
    "README.md"
  ],
  "sideEffects": [
    "**/*.css"
  ],
  "scripts": {
    "test": "node --test tests/package.test.mjs tests/catalog.test.mjs",
    "prepack": "npm test",
    "dev": "npm run dev --workspace=aether-demo",
    "build": "npm run build --workspace=aether-demo",
    "start": "npm run start --workspace=aether-demo",
    "typecheck": "npm run typecheck --workspace=aether-demo"
  },
  "dependencies": {
    "@fontsource-variable/geist": "5.3.0",
    "@fontsource-variable/jetbrains-mono": "5.3.0"
  },
  "peerDependencies": {
    "tailwindcss": "^4.0.0"
  },
  "publishConfig": {
    "access": "public"
  },
  "repository": {
    "type": "git",
    "url": "git+https://github.com/xkintaro/aether.git"
  },
  "homepage": "https://github.com/xkintaro/aether#readme",
  "workspaces": [
    "demo"
  ]
}
